      "from": 288,
      "to": 556,
      "label": "主 Agent 出卡"
    },
    {
      "from": 566,
      "to": 712,
      "label": "代码校验 · 试抓 · 出卡"
    },
    {
      "from": 722,
      "to": 930,
      "label": "你确认 · 代码执行 · 记录"
    }
