  "messages": [
    {
      "id": "say",
      "from": "you",
      "to": "box",
      "y": 165,
      "label": "「以后也追踪港股服装公司的公告」",
      "variant": "emphasis"
    },
    {
      "id": "classify",
      "from": "box",
      "to": "route",
      "y": 195,
      "label": "这句话 + libraryId",
      "note": "先用规则（以后 / 追踪 / 加 / 删 / 别再 / 改成）再交模型判，带置信度；拿不准就问你「这是要改库吗？」"
    },
    {
      "id": "handoff",
      "from": "route",
      "to": "agent",
      "y": 262,
      "label": "改动要求 + 库 id",
      "variant": "emphasis"
    },
    {
      "id": "ask-model",
      "from": "agent",
      "to": "model",
      "y": 300,
      "label": "局面摘要 + 你这句话",
      "variant": "emphasis",
      "note": "局面摘要：各库名字 / 要求 / 待看数 / 问题 / 待定的提议"
    },
    {
      "id": "json1",
      "from": "model",
      "to": "agent",
      "y": 370,
      "label": "JSON：reply · ask? · proposals[] · lookups[]",
      "variant": "return",
      "note": "不合格式重试一次；再不行只显示 reply，不出卡"
    },
    {
      "id": "lookup",
      "from": "agent",
      "to": "disk",
      "y": 420,
      "label": "lookups 由代码查（某库概况 / 抓取记录）",
      "variant": "dashed"
    },
    {
      "id": "lookup-back",
      "from": "disk",
      "to": "agent",
      "y": 450,
      "label": "查到的东西",
      "variant": "return"
    },
    {
      "id": "feed",
      "from": "agent",
      "to": "model",
      "y": 480,
      "label": "喂回去（最多 3 次）",
      "note": "超过 3 次就照现有信息答"
    },
    {
      "id": "json2",
      "from": "model",
      "to": "agent",
      "y": 540,
      "label": "proposals[]",
      "variant": "return"
    },
    {
      "id": "validate",
      "from": "agent",
      "to": "proposals",
      "y": 578,
      "label": "proposals[] 交代码校验",
      "variant": "security",
      "note": "schema 校验；状态：待定"
    },
    {
      "id": "tryfetch",
      "from": "proposals",
      "to": "fetch",
      "y": 630,
      "label": "加来源先试抓一次"
    },
    {
      "id": "tryfetch-back",
      "from": "fetch",
      "to": "proposals",
      "y": 660,
      "label": "试抓结果",
      "variant": "return"
    },
    {
      "id": "card",
      "from": "proposals",
      "to": "box",
      "y": 695,
      "label": "提议卡：改什么 · 为什么 · 改前 / 改后 · 试抓结果",
      "variant": "emphasis"
    },
    {
      "id": "confirm",
      "from": "you",
      "to": "box",
      "y": 735,
      "label": "确认（也可以 不要 / 改一下）",
      "variant": "emphasis",
      "note": "改一下 = 把你的话带回主 Agent 重出一张"
    },
    {
      "id": "confirm-code",
      "from": "box",
      "to": "proposals",
      "y": 790,
      "label": "确认（只认这一个）",
      "variant": "security"
    },
    {
      "id": "write-config",
      "from": "proposals",
      "to": "disk",
      "y": 825,
      "label": "代码改 streams.json：加来源 · 加关键词",
      "variant": "security",
      "note": "旁边记「主 Agent 提的 · 你确认的 · 日期」"
    },
    {
      "id": "write-log",
      "from": "proposals",
      "to": "disk",
      "y": 880,
      "label": "记 proposals.jsonl（全局一份 + 本库一份）",
      "variant": "dashed"
    },
    {
      "id": "done",
      "from": "proposals",
      "to": "box",
      "y": 915,
      "label": "已生效：来源与要求页可见",
      "variant": "return"
    }
  ],
  "activations": [
