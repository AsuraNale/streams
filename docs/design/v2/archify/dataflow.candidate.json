  "cards": [
    {
      "dot": "emerald",
      "title": "代码做的（不调模型）",
      "items": [
        "触发、排队（同一时间只跑一轮，错过补一轮不叠加）、抓取、去重、写账本、规则型建议检查",
        "核验的规则项也是代码：固定模式找「忽略之前的要求」「你现在是…」这类写给 AI 的指令"
      ]
    },
    {
      "dot": "orange",
      "title": "库 Agent 调用",
      "items": [
        "关卡① 相关度、关卡② 实质、摘要、核验判定项：每条 / 每批一次「不能动手」的调用，不留会话，提示词带库的 brief",
        "只交结构化结果（分数、理由、摘要、核验结论），由代码写账本"
      ]
    },
    {
      "dot": "rose",
      "title": "「写给 AI 的话」规则（v2 新加）",
      "items": [
        "规则项（固定模式）+ 判定项兜底；命中的条目在待看上标「这一条里有写给 AI 的话，已忽略」",
        "给来源记一笔，规则型建议检查据此出「建议暂停这个来源」的建议卡；来源和库配置零改动",
        "规则会漏：库 Agent 不能动手是根本防线，漏了也只影响那一条的分数"
      ]
    },
    {
      "dot": "amber",
      "title": "开工前",
      "items": [
        "这是开工前的计划：每轮上限改为按库算（cap），触发与排队、建议检查与「写给 AI 的话」规则都还没写"
      ]
    }
  ]
