{
  "measuredBy": "tools/contrast.mjs",
  "probes": [
    {
      "id": "body-page",
      "kind": "正文",
      "what": "正文 / 主区底（对话里主 Agent 的话）",
      "screen": "chat",
      "sel": "#main .intro-copy",
      "min": 4.5
    },
    {
      "id": "body-surface",
      "kind": "正文",
      "what": "正文 / 卡片（库架卡片的「在追」）",
      "screen": "shelf",
      "sel": "#main .tile-track",
      "min": 4.5
    },
    {
      "id": "body-side",
      "kind": "正文",
      "what": "正文 / 左栏（没选中的库名）",
      "screen": "inbox",
      "sel": "#sidebar .project-item:not(.active) .project-name",
      "min": 4.5
    },
    {
      "id": "body-selected",
      "kind": "正文",
      "what": "正文 / 选中底（左栏当前的库）",
      "screen": "inbox",
      "sel": "#sidebar .project-item.active .project-name",
      "min": 4.5
    },
    {
      "id": "body-panel-card",
      "kind": "正文",
      "what": "正文 / 右栏卡片（等你决定的标题）",
      "screen": "shelf",
      "sel": "#panel .decide-card b",
      "min": 4.5
    },
    {
      "id": "sub-page",
      "kind": "次要",
      "what": "次要 / 主区底（页头说明）",
      "screen": "shelf",
      "sel": "#main .work-header .header-meta",
      "min": 3
    },
    {
      "id": "sub-surface",
      "kind": "次要",
      "what": "次要 / 卡片（库架卡片「上次更新」）",
      "screen": "shelf",
      "sel": "#main .tile-meta",
      "min": 3
    },
    {
      "id": "sub-side",
      "kind": "次要",
      "what": "次要 / 左栏（库名下的状态）",
      "screen": "inbox",
      "sel": "#sidebar .project-item:not(.active) .project-meta",
      "min": 3
    },
    {
      "id": "sub-quota",
      "kind": "次要",
      "what": "次要 / 左下角余量（重置时间）",
      "screen": "shelf",
      "sel": "#sidebar .quota-row small",
      "min": 3
    },
    {
      "id": "sub-panel",
      "kind": "次要",
      "what": "次要 / 右栏摘要块（小标题）",
      "screen": "shelf",
      "sel": "#panel .panel-summary .eyebrow",
      "min": 3
    },
    {
      "id": "btn-primary",
      "kind": "按钮",
      "what": "主按钮字 / 强调色（「新建库」）",
      "screen": "shelf",
      "sel": "#main .work-header .btn.primary",
      "min": 4.5
    },
    {
      "id": "btn-secondary",
      "kind": "按钮",
      "what": "次要按钮字 / 按钮底（阅读区「编辑」）",
      "screen": "library",
      "sel": "#main .reader-tools .btn",
      "min": 4.5
    },
    {
      "id": "btn-card",
      "kind": "按钮",
      "what": "卡片上的次要按钮（待看「稍后」）",
      "screen": "inbox",
      "sel": "#main .source-card:not(.selected) .card-actions .btn:not(.primary)",
      "min": 4.5
    },
    {
      "id": "btn-tab",
      "kind": "按钮",
      "what": "当前标签字 / 选中底（库页「待看」）",
      "screen": "inbox",
      "sel": "#main .lib-tabs .tab.active",
      "min": 4.5
    },
    {
      "id": "state-wait",
      "kind": "状态",
      "what": "琥珀字 / 琥珀浅底（「写给 AI 的话」标记）",
      "screen": "inbox",
      "sel": "#main .ai-mark",
      "min": 4.5
    },
    {
      "id": "state-done",
      "kind": "状态",
      "what": "绿字 / 绿浅底（「已收藏」）",
      "screen": "library",
      "sel": "#main .status-pill--done",
      "min": 4.5
    },
    {
      "id": "state-cite",
      "kind": "状态",
      "what": "紫字 / 紫浅底（问库的出处编号）",
      "screen": "ask",
      "sel": "#main .answer .cite",
      "min": 4.5
    }
  ],
