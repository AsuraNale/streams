  "decisions": [
    {
      "date": "2026-11-02",
      "by": "维护者（方案 §1.7、V7）",
      "what": "Bronze / Silver / Gold 对用户叫：抓到的 / 待看 / 已收藏；judge / relevance / threshold 叫：打分 / 相关度 / 过关线；promote / dismiss 叫：收藏 / 放弃；五种抓取状态叫：正常 / 没新内容 / 地址有问题 / 暂时失败 / 被拒绝；one_line 叫「这是什么」；keeper、Intake Gate、Preflight、selftest、pending.json、judgments.json、ledger 不出现（redesign R6b：此条照原文保留，五种抓取状态现行的词见 2026-11-13 一条）"
    },
    {
      "date": "2026-11-02",
      "by": "维护者（V7）",
      "what": "品牌词 Claude / Anthropic / OpenAI / ChatGPT 只出现在「连接你电脑上的 Claude Code」「连接你电脑上的 Codex」这类措辞、型号表和许可证页"
    },
    {
      "date": "2026-11-13",
      "by": "维护者（2026-11-11 过目第 1 条；05-措辞规范 第三节；redesign R6b-1）",
      "what": "五种抓取状态改叫：正常 / 无更新 / 地址无效 / 暂时失败 / 访问被拒（英文 OK / No updates / Invalid address / Temporary failure / Access denied）；界面中英字典、core 给主 Agent 的词（STATE_WORDS）与本表三处逐字相同，由测试核对"
    },
    {
      "date": "2026-11-14",
      "by": "玄翎（redesign R6b-3；契约 2026-11-13）",
      "what": "英文用词表写进本表 english 一节：待看 Inbox、库架 Shelf、资料库 Library、问库 Ask、来源与要求 Sources & Brief、追踪要求 Brief、主 Agent Main agent、收藏 / 放弃 / 稍后处理 Keep / Discard / Later、忽略 Dismiss、待确认 To confirm、系统检测 Detected by Streams、运行 run（核验的第 n 轮仍叫 round）、核验 verification；放弃的英文由 Let go 改为 Discard；对 05 英文建议稿的两处有意偏离（第 145、167 行）记在 english.deviations"
    }
  ],
  "principles": [
    "不出现英文内部词、文件名和带下划线的字段名：Silver、pending.json、one_line 这类。",
    "库里的东西只有一套名字：抓到的、待看、已收藏；一条过没过关说「相关度」和「过关线」。",
    "流水线的动作说成它对用户的意思：收藏、放弃；不说 promote、dismiss、judge。",
    "一个来源出了什么事只说五种之一：正常、无更新、地址无效、暂时失败、访问被拒。",
    "品牌只在说「连接你电脑上的 …」、型号表和许可证页时出现。"
  ],
