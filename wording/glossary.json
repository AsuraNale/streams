{
  "schema": "streams.glossary/1",
  "version": "1.0.0-dev.0",
  "updated": "2026-11-02",
  "about": "用户可见用词的单一来源：内部词 → 对用户的说法（产品方案 §1.7 的对照表）。内部文件、脚本、规格里的原词保留不动；只换对用户说的话。扫描器（banned-terms.json）从这里取建议；界面字典（desktop/src/renderer/texts）照这里的词写。机制沿用外壳来源的词表（致谢见 docs/wording.md）；内容是流息的。",
  "source": {
    "entries": "流息产品方案 §1.7 对照表（2026-11-02）",
    "principles": "同上 §1.7 与验收 V7"
  },
  "columns": {
    "zh": "对用户说（中文）",
    "en": "对用户说（英文，Streams）",
    "gloss": "第一次提到时可以带上的一句解释"
  },
  "actions": {
    "rename": "对用户换成 zh / en",
    "prefer": "原词可以留，建议用 zh / en",
    "keep": "用户本来就懂，照用（可能有限制，见 note）",
    "hide": "不该出现在用户面前；需要时换说法或干脆不说"
  },
  "groups": {
    "A": "库里的三级",
    "B": "打分与过关",
    "C": "收藏与放弃",
    "D": "抓取状态",
    "E": "内部文件、检查与环境",
    "F": "品牌"
  },
  "decisions": [
    {
      "date": "2026-11-02",
      "by": "维护者（方案 §1.7、V7）",
      "what": "Bronze / Silver / Gold 对用户叫：抓到的 / 待看 / 已收藏；judge / relevance / threshold 叫：打分 / 相关度 / 过关线；promote / dismiss 叫：收藏 / 放弃；五种抓取状态叫：正常 / 没新内容 / 地址有问题 / 暂时失败 / 被拒绝；one_line 叫「这是什么」；keeper、Intake Gate、Preflight、selftest、pending.json、judgments.json、ledger 不出现"
    },
    {
      "date": "2026-11-02",
      "by": "维护者（V7）",
      "what": "品牌词 Claude / Anthropic / OpenAI / ChatGPT 只出现在「连接你电脑上的 Claude Code」「连接你电脑上的 Codex」这类措辞、型号表和许可证页"
    }
  ],
  "principles": [
    "不出现英文内部词、文件名和带下划线的字段名：Silver、pending.json、one_line 这类。",
    "库里的东西只有一套名字：抓到的、待看、已收藏；一条过没过关说「相关度」和「过关线」。",
    "流水线的动作说成它对用户的意思：收藏、放弃；不说 promote、dismiss、judge。",
    "一个来源出了什么事只说五种之一：正常、没新内容、地址有问题、暂时失败、被拒绝。",
    "品牌只在说「连接你电脑上的 …」、型号表和许可证页时出现。"
  ],
  "fetch_states_about": "id 是 desktop/src/shared/fetch-states.mjs 的五个状态键（由测试核对）；zh / en 是界面上的词（desktop/src/renderer/texts/common.js FETCH_STATES 与 texts-en 同名表照此）。",
